{
  "name": "@stackline/crc-32",
  "version": "1.0.1",
  "author": "sheetjs",
  "description": "CRC-32 and CRC-32C checksums for strings and byte buffers, preserving the SheetJS CRC API",
  "keywords": [
    "stackline",
    "npm-package",
    "crc-32",
    "typescript",
    "nodejs",
    "crc",
    "crc32",
    "checksum"
  ],
  "bin": {
    "crc32": "bin/crc32.njs"
  },
  "main": "crc32.js",
  "types": "types/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "types/index.d.ts"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "mocha": "12.0.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-crc-32.git"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "mocha --timeout 60000 test.js test/*.cjs",
    "test:types": "tsc -p types/tsconfig.json",
    "lint": "node --check crc32.js && node --check crc32c.js && node --check < bin/crc32.njs"
  },
  "homepage": "https://alexandro.net/docs/vanilla/crc-32/",
  "files": [
    "crc32.js",
    "crc32c.js",
    "bin/crc32.njs",
    "LICENSE",
    "README.md",
    "types/index.d.ts",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-crc-32/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
